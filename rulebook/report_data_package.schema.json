{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report data package (报告数据包)",
  "description": "求值线产物 / 成文线 input_snapshot 内容本体（图 v0.2 §2）。自包含：成文线不回查任何库——persona 全文、cr- 判据、禁词表随包。匿名：additionalProperties=false 结构性排除任何用户/项目标识（图 v0.2 §0）。生产方=project-svc 规则引擎（Jackson camelCase 序列化）；消费方=reportgen report-unit-compose。确定性：anchors/withheldAnchors/gaps 按 lkpId、releases 按 domain、域内资产按 assetId 排序，同输入字节级同输出（规则 8.2）。降档门禁（规则 4.10）在生产侧执行：entitlement 是判定口径，anchors[].presentation 是判定结果，隐藏档的落点不在 anchors 内、只在 withheldAnchors 留审计。",
  "type": "object",
  "properties": {
    "entitlement": {
      "type": "string",
      "enum": ["FREE", "PAID"],
      "description": "本包服务的产物权益档（规范 §3.1 产物登记表权益列，由调用方按它在生成哪个 art- 传入——规则引擎不持有产物清单）。降档判定的唯一口径；一次求值只服务一个权益档，混档产物分两次求值。它是产物属性不是用户属性，不破匿名纪律。"
    },
    "domains": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本包覆盖的知识域（去前缀形态，按字典序）"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": { "type": "string" },
          "releaseTag": { "type": "string", "pattern": "^[a-z][a-z-]*@v[0-9]+$" }
        },
        "required": ["domain", "releaseTag"],
        "additionalProperties": false
      },
      "description": "消费的 release 引用集（版本锁定，规则 8.2；产物 lineage 记录同一集合）"
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lkpId": { "type": "string", "pattern": "^lkp-" },
          "name": { "type": "string" },
          "numberClass": { "type": ["string", "null"], "enum": ["locating", "selection", "analysis", null] },
          "unit": { "type": ["string", "null"] },
          "value": { "type": "object", "description": "求值后数值包（min/max/v/分档键，异构）" },
          "basisTag": { "type": "string", "description": "依据 release 引用" },
          "source": { "type": ["string", "null"], "description": "推导可见的出处" },
          "calibration": { "type": "string", "enum": ["draft", "calibrated", "needs_review"] },
          "degraded": { "type": "boolean", "description": "标记：未过可核性门（calibration != calibrated）" },
          "presentation": {
            "type": "string",
            "enum": ["THESIS_SUPPORT", "REFERENCE_ONLY"],
            "description": "强制：降档纪律的判定结果（规则 4.10）= degraded × entitlement × 值形态。THESIS_SUPPORT=可作判断句支点（规则 5.8 断言预算的背书来源）；REFERENCE_ONLY=降档为参考形态，只可区间/参考口吻，禁作判断句支点。判为隐藏的落点不出现在本数组内（见 withheldAnchors），故此枚举无 WITHHELD 值。"
          }
        },
        "required": ["lkpId", "name", "value", "basisTag", "calibration", "degraded", "presentation"],
        "additionalProperties": false
      },
      "description": "落点对象：成文线数字字段唯一合法来源（正文禁裸数字，经 {lkp-*} 占位引用）"
    },
    "withheldAnchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lkpId": { "type": "string", "pattern": "^lkp-" },
          "basisTag": { "type": "string", "description": "来源 release 引用（供审计定位到域与版本）" },
          "reason": {
            "type": "string",
            "enum": ["locating_number", "no_range_form"],
            "description": "locating_number=定位数字无参考形态（规则 2.2/2.3）；no_range_form=值非区间形态，降不成参考级只出区间的说法（规则 5.8）"
          }
        },
        "required": ["lkpId", "basisTag", "reason"],
        "additionalProperties": false
      },
      "description": "按规则 4.10 隐藏的落点审计：**只有 id 与原因，无值、无 source、无名称**——隐藏即内容不下发，成文线拿不到可写的东西。与 gaps 分列：gap- 是求不出（补公式/补输入），withheld 是求出了但纪律不许发（补外部依据转正），两条回流信号不混。"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lkpId": { "type": "string" },
          "reason": { "type": "string", "enum": ["missing_input", "formula_not_implemented", "empty_definition"] },
          "detail": { "type": ["string", "null"] }
        },
        "required": ["lkpId", "reason"],
        "additionalProperties": false
      },
      "description": "求值缺口（gap-）：随产物回流，不阻塞"
    },
    "personasByDomain": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "assetId": { "type": "string", "pattern": "^persona-" },
            "identity": { "type": "string", "description": "语域身份（回路编译产物，非手册原文——规则 4.19）" },
            "judgmentSamples": { "type": "array" },
            "assertionBudget": { "type": "array", "description": "[{predicate, requires:[lkp-*]}]——判断句须 requires 已求值（规则 5.8）" },
            "bannedTerms": { "type": "object", "description": "域内禁词（domain_extra 等；公共禁词在 bannedTermsByDomain）" },
            "version": { "type": "integer" }
          },
          "required": ["assetId", "identity", "version"],
          "additionalProperties": false
        }
      }
    },
    "checksByDomain": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "assetId": { "type": "string", "pattern": "^cr-" },
            "checkType": { "type": "string" },
            "scope": { "type": "array", "items": { "type": "string" } },
            "pattern": { "type": ["string", "null"] },
            "requirement": { "type": ["string", "null"] },
            "message": { "type": "string" },
            "decidedBy": { "type": "string", "description": "裁决记录锚（规则 4.10b，非空）" },
            "thresholdRefs": { "type": "array", "items": { "type": "string" }, "description": "数值阈值只经 lkp- 引用" },
            "version": { "type": "integer" }
          },
          "required": ["assetId", "checkType", "message", "decidedBy", "version"],
          "additionalProperties": false
        }
      },
      "description": "cr- 机检判据（release 数据物化执行，不硬编码）"
    },
    "bannedTermsByDomain": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } },
      "description": "vocabulary(kind=banned_term) 平铺去重排序（公共禁词发布时已物化进各域）"
    },
    "anonymousProfile": {
      "type": "object",
      "properties": {
        "chiefHeightMm": { "type": ["integer", "null"] },
        "tallestHeightMm": { "type": ["integer", "null"] },
        "eyeHeightMm": { "type": ["integer", "null"] },
        "tvScreenHeightMm": { "type": ["integer", "null"] },
        "layoutFeatures": { "type": "object", "additionalProperties": { "type": "string" }, "description": "estate 标注户型特征（规则 6.3 字段）" }
      },
      "required": ["layoutFeatures"],
      "additionalProperties": false,
      "description": "匿名画像：禁止任何用户/项目标识字段"
    }
  },
  "required": ["entitlement", "domains", "releases", "anchors", "withheldAnchors", "gaps", "personasByDomain", "checksByDomain", "bannedTermsByDomain", "anonymousProfile"],
  "additionalProperties": false
}
