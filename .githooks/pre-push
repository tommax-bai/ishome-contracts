#!/usr/bin/env bash
# 本地 pre-push 质量门（云端 CI 因账号计费停用期间的替代把关）。
# 新 clone 后需执行一次：git config core.hooksPath .githooks
# 紧急绕过：git push --no-verify（仅限确认过风险时使用）。
set -euo pipefail
cd "$(dirname "$0")/.."
echo "== pre-push: buf lint"
buf lint
echo "== pre-push: buf build"
buf build
echo "== pre-push: locked_texts md ↔ json 一致性"
python3 scripts/check_locked_texts_sync.py
echo "== pre-push: OK"
